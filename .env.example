# ── Required ──────────────────────────────────────────────────────────────────

# Your validator stash address (SS58)
VALIDATOR_ADDRESS=14PkBX3BUF71wDh44BLeNby2u7X9ZBu36V28LMcBrdK35yC2

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram chat/channel ID where alerts are sent
TELEGRAM_CHAT_ID=your_chat_id_here

# ── RPC Endpoints ─────────────────────────────────────────────────────────────

# Asset Hub WebSocket (staking data lives here post-AHM)
RPC_ENDPOINT=wss://polkadot-asset-hub-rpc.polkadot.io

# Relay Chain WebSocket (session keys live here)
RC_RPC_ENDPOINT=wss://rpc.polkadot.io

# Validator node HTTP RPC for health check (leave empty to disable)
# Example: http://127.0.0.1:9933
NODE_RPC_ENDPOINT=

# ── Optional ──────────────────────────────────────────────────────────────────

NETWORK=polkadot
DB_PATH=./data/state.db

# Intervals in milliseconds
HEARTBEAT_INTERVAL=60000
NOTIFICATION_COOLDOWN=300000
NOM_CHECK_INTERVAL=300000
KEY_CHECK_INTERVAL=300000
PENDING_CHECK_INTERVAL=14400000
NODE_HEALTH_INTERVAL=60000

# Thresholds
# Heartbeat: consecutive missed intervals / received blocks for RPC lost/restored alerts
OFFLINE_THRESHOLD=3
ONLINE_THRESHOLD=2

# Validator node health (NODE_RPC_ENDPOINT): consecutive checks before an alert.
# Default to OFFLINE_THRESHOLD / ONLINE_THRESHOLD if unset.
NODE_OFFLINE_THRESHOLD=3
NODE_ONLINE_THRESHOLD=2
# Consecutive isSyncing=true checks before "node is syncing" alert
NODE_SYNC_THRESHOLD=5

# Minimum DOT change to trigger nominator stake change alert
MIN_STAKE_CHANGE=100

# Phragmén scheduler — UTC hours to run slot position analysis (comma-separated)
# These are UTC+3: 4:00, 9:00, 16:00, 22:00
RANK_SCHEDULE_UTC=1,6,13,19
